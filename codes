#!/bin/bash

echo "Enter a year:"
read year

if (( year % 400 == 0 )); then
    echo "$year is a leap year"
elif (( year % 100 == 0 )); then
    echo "$year is not a leap year"
elif (( year % 4 == 0 )); then
    echo "$year is a leap year"
else
    echo "$year is not a leap year"
fi

#!/bin/bash

echo "Enter directory path:"
read dir

if [ -d "$dir" ]; then
    count=$(find "$dir" -maxdepth 1 -type f | wc -l)
    echo "Number of files: $count"
else
    echo "Directory does not exist"
fi

#!/bin/bash

echo "Enter a number:"
read n

if (( n < 2 )); then
    echo "$n is not a prime number"
    exit
fi

for (( i=2; i*i<=n; i++ ))
do
    if (( n % i == 0 )); then
        echo "$n is not a prime number"
        exit
    fi
done

echo "$n is a prime number"





#!/bin/bash

echo "Enter list elements separated by spaces:"
read -a arr

echo "Enter element to search:"
read key

found=0

for item in "${arr[@]}"
do
    if [ "$item" = "$key" ]; then
        found=1
        break
    fi
done

if (( found == 1 )); then
    echo "$key found in the list"
else
    echo "$key not found in the list"
fi




#!/bin/bash

echo "----- CALCULATOR -----"
echo "1. Addition"
echo "2. Subtraction"
echo "3. Multiplication"
echo "4. Division"

echo "Enter your choice:"
read ch

echo "Enter two numbers:"
read a b

case $ch in
    1)
        echo "Result: $((a + b))"
        ;;
    2)
        echo "Result: $((a - b))"
        ;;
    3)
        echo "Result: $((a * b))"
        ;;
    4)
        if [ "$b" -eq 0 ]; then
            echo "Error: Division by zero"
        else
            echo "Result: $((a / b))"
        fi
        ;;
    *)
        echo "Invalid choice"
        ;;
esac
